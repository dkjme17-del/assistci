# Copier en `.env` à la racine puis adapter (n'est jamais commité).

# --- Domaine public (Caddy auto-TLS) ---
DOMAIN=assistci.ci

# --- Base de données PostgreSQL ---
# Base managée (recommandé, ex. Neon) : chaîne complète, prioritaire sur PG*.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
# PostgreSQL self-hosted (utiliser alors docker-compose.db.yml) :
# PGDATABASE=assistci_db
# PGUSER=postgres
# PGPASSWORD=changez_moi_en_production
# (optionnel) exposer la base en local : docker-compose.dev.yml + docker-compose.db.yml

# --- API ---
# Générez une valeur unique : openssl rand -base64 48
JWT_SECRET=changez_moi_valeur_unique_de_48_caracteres_minimum
# Origines autorisées (séparées par des virgules). En prod derrière Caddy
# avec une URL API relative, cette valeur peut rester vide ou égale au domaine.
CORS_ORIGINS=*

# URL de l'API injectée au build du front. `/api` = même origine (recommandé en prod).
NEXT_PUBLIC_API_URL=/api
