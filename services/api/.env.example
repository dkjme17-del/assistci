PORT=4001
NODE_ENV=development

# Base de données PostgreSQL
# Option A — chaîne complète (recommandé, ex. Neon) : prioritaire sur les PG*
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base?sslmode=require
# Option B — variables séparées (PostgreSQL local)
PGHOST=localhost
PGPORT=5432
PGDATABASE=assistci_db
PGUSER=postgres
PGPASSWORD=postgres

# Sécurité & Tokens
JWT_SECRET=super_secret_assistci_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Microservice IA
AI_SERVICE_URL=http://localhost:8000

