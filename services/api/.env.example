PORT=4001
NODE_ENV=development

# Base de données PostgreSQL
# Option A — chaîne complète (recommandé, ex. Neon) : prioritaire sur les PG*
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base?sslmode=require
# Option B — variables séparées (PostgreSQL local)
PGHOST=localhost
PGPORT=5432
PGDATABASE=assistci_db
PGUSER=postgres
PGPASSWORD=postgres

# Sécurité & Tokens
JWT_SECRET=super_secret_assistci_jwt_key_2026_change_in_production
# Jeton d'accès court (le refresh token prend le relais)
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30

# URL publique du front (liens email de vérification / réinitialisation)
APP_URL=http://localhost:3001

# Emails : console (dev) ou resend (prod)
EMAIL_PROVIDER=console
EMAIL_FROM=ASSISTCI <no-reply@assistci.ci>
# RESEND_API_KEY=re_xxxxxxxxx

# SMS : console (dev) ou http (passerelle opérateur)
SMS_PROVIDER=console
# SMS_HTTP_URL=https://sms.exemple.ci/send
# SMS_HTTP_TOKEN=xxxxxxxxx

# Paiements (laisser false tant que la passerelle n'est pas configurée)
PAYMENTS_ENABLED=false
# Wave
WAVE_API_KEY=
WAVE_BASE_URL=https://api.wave.com/v1
WAVE_WEBHOOK_SECRET=
# Passerelle Mobile Money générique (Orange/MTN/Moov/carte via agrégateur)
PAYMENT_HTTP_URL=
PAYMENT_HTTP_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# Microservice IA
AI_SERVICE_URL=http://localhost:8000

# Limitation de débit (par fenêtre)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Limite stricte login/inscription (15 min par défaut)
AUTH_STRICT_RATE_LIMIT_WINDOW_MS=900000
AUTH_STRICT_RATE_LIMIT_MAX=10

# Verrouillage après échecs de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

